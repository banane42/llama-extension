[configuration]
entry_symbol = "llama_library_init"
compatibility_minimum = "4.1"

[libraries]
windows.debug.x86_64   = "res://bin/libllama_ext.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libllama_ext.windows.template_release.x86_64.dll"

[dependencies]
windows.debug.x86_64 = {
    "res://bin/llama.dll": "",
    "res://bin/ggml.dll": "",
    "res://bin/ggml-base.dll": "",
    "res://bin/ggml-cpu.dll": ""
}